<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>مشغل M3U المباشر</title>
<script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
<style>
body {
font-family: Tahoma, sans-serif;
background-color: #121212;
color: #ffffff;
margin: 0;
padding: 20px;
}
.container {
max-width: 950px;
margin: auto;
background: #1e1e1e;
padding: 20px;
border-radius: 10px;
box-shadow: 0 4px 10px rgba(0,0,0,0.5);
}
h2 {
text-align: center;
color: #4CAF50;
}
.content {
display: flex;
gap: 20px;
margin-top: 20px;
}
#playlist {
flex: 1;
max-height: 450px;
overflow-y: auto;
background: #2b2b2b;
padding: 10px;
border-radius: 5px;
}
.channel-item {
padding: 10px;
cursor: pointer;
border-bottom: 1px solid #3d3d3d;
transition: background 0.2s;
font-size: 14px;
}
.channel-item:hover {
background: #3d3d3d;
color: #4CAF50;
}
video {
flex: 2;
width: 100%;
max-height: 450px;
background: #000;
border-radius: 5px;
}
.status {
text-align: center;
color: #888;
margin-bottom: 10px;
}
</style>
</head>
<body onload="loadM3U()">

<div class="container">
<h2>مشغل القنوات عبر GitHub & jsDelivr</h2>
<div class="status" id="statusText">جاري تحميل القنوات تلقائياً...</div>

<div class="content">
<!-- قائمة القنوات -->
<div id="playlist"></div>

<!-- مشغل الفيديو -->
<video id="videoPlayer" controls autoplay></video>
</div>
</div>

<script>
// 🌐 ضع رابط jsDelivr الخاص بملف الـ M3U الخاص بك هنا:
const m3uUrl = "http://goldenpass.xyz/get.php?username=MAG1ADWZGJ&password=MAGCUFLW6S&type=m3u_plus";

const video = document.getElementById('videoPlayer');
const playlistDiv = document.getElementById('playlist');
const statusText = document.getElementById('statusText');

function playStream(url) {
if (Hls.isSupported() && (url.includes('.m3u8') || url.includes('ts'))) {
const hls = new Hls();
hls.loadSource(url);
hls.attachMedia(video);
hls.on(Hls.Events.MANIFEST_PARSED, function() {
video.play();
});
} else {
video.src = url;
video.play();
}
}

async function loadM3U() {
try {
// استخدام وكيل CORS لجلب الملف بسلاسة
const proxyUrl = 'https://api.allorigins.win/raw?url=' + encodeURIComponent(m3uUrl);
const response = await fetch(proxyUrl);
const data = await response.text();

parseM3U(data);
} catch (error) {
statusText.innerHTML = '<span style="color: red;">فشل تحميل القنوات. تأكد من رابط jsDelivr.</span>';
console.error(error);
}
}

function parseM3U(data) {
const lines = data.split('\n');
let channels = [];
let currentTitle = "قناة بدون اسم";

lines.forEach(line => {
line = line.trim();
if (line.startsWith('#EXTINF:')) {
let parts = line.split(',');
if (parts.length > 1) {
currentTitle = parts[parts.length - 1];
}
} else if (line && !line.startsWith('#')) {
channels.push({ title: currentTitle, url: line });
currentTitle = "قناة بدون اسم";
}
});

displayPlaylist(channels);
}

function displayPlaylist(channels) {
playlistDiv.innerHTML = '';
if (channels.length === 0) {
statusText.innerText = 'الملف لا يحتوي على قنوات صالحة.';
return;
}

statusText.innerText = تم تحميل (${channels.length}) قناة بنجاح!;

channels.forEach(ch => {
const div = document.createElement('div');
div.className = 'channel-item';
div.innerText = ch.title;
div.onclick = () => playStream(ch.url);
playlistDiv.appendChild(div);
});
}
</script>

</body>
</html>

